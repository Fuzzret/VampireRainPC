diff --git a/XenonRecomp/CMakeLists.txt b/XenonRecomp/CMakeLists.txt
index f5db6d1..486e8a1 100644
--- a/XenonRecomp/CMakeLists.txt
+++ b/XenonRecomp/CMakeLists.txt
@@ -21,7 +21,10 @@ if (CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
     target_compile_options(XenonRecomp PRIVATE -Wno-switch -Wno-unused-variable -Wno-null-arithmetic)
 
     # alias attribute not supported on Apple.
-    if (NOT APPLE)
+    # (vampirerain: weak functions are emitted as small wrappers instead of
+    # aliases on every platform - the runtime overrides them, which aliases
+    # don't allow with the MSVC-style linker.)
+    if (FALSE)
         target_compile_definitions(XenonRecomp PRIVATE XENON_RECOMP_USE_ALIAS)
     endif()
 endif()
